<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into the SignPath project's "initial" artifact configuration.
     GitHub delivers the uploaded artifact as a zip containing tachyon.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="tachyon.exe" product-name="Tachyon">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
